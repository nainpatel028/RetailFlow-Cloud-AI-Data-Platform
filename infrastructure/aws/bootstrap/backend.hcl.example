# Copy this file to backend.hcl (gitignored) and fill in real values from
# this stack's own outputs (after the first apply with local state):
#
#   terraform output state_bucket_name
#
# Then migrate the local state into the bucket:
#
#   terraform init -backend-config=backend.hcl -migrate-state
#
# Do not put the account ID, credentials, or the real bucket name in any
# tracked file - only in this untracked copy.

bucket       = "<state-bucket-name-from-bootstrap-output>"
key          = "bootstrap/terraform.tfstate"
region       = "ca-central-1"
encrypt      = true

# Native S3 state locking (Terraform >= 1.11) - no DynamoDB lock table,
# since DynamoDB-based locking is deprecated.
use_lockfile = true

# Optional: named AWS CLI profile, if you don't use AWS_PROFILE.
# profile    = "<your-aws-profile>"
