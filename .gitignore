# Environment / secrets
.env
*.env.local
**/credentials/
**/*credentials*.json
**/*.pem
**/*.key

# Python virtual environments
.venv/
venv/
env/
ENV/

# Python caches
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# pytest / test caches
.pytest_cache/
.cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# IDE
.vscode/
.idea/
*.swp

# Temporary outputs
*.tmp
*.log
tmp/
temp/

# Local database files
*.db
*.sqlite
*.sqlite3

# Power BI temporary/backup files
*.pbix.bak
~$*.pbix
*.pbit.bak

# Generated synthetic source data (Parquet). Regenerable via
# `python scripts/generate_data.py` against seed 42 — not tracked in git,
# since the portfolio profile alone is millions of rows. Each profile's
# manifest.json (row counts, file hashes, injected issue codes/rates) is
# small and IS tracked, so the intended output stays documented.
data/incoming/*/customers/
data/incoming/*/orders/
data/incoming/*/payments/

# Terraform (infrastructure/aws/) — local working files and anything that
# could contain real account-specific values are ignored. Module source,
# the dependency lock file, and the *.example templates ARE tracked so the
# intended configuration stays documented.
**/.terraform/*
*.tfstate
*.tfstate.*
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# Real tfvars/backend config (contains real values) — keep the .example
# templates tracked.
*.tfvars
!*.tfvars.example
backend.hcl
!backend.hcl.example
