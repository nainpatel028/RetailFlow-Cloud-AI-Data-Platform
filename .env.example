# Example environment file.
#
# This file documents the environment variables the platform will use as
# later tickets are implemented. It contains PLACEHOLDERS ONLY — no real
# values, hosts, or credentials.
#
# To use: copy this file to `.env` (which is gitignored) and fill in real
# values locally. Never commit a `.env` file.

# --- Local SQL (used starting with RF-002+) ---
RETAILFLOW_SQL_HOST=localhost
RETAILFLOW_SQL_PORT=5432
RETAILFLOW_SQL_DATABASE=retailflow
RETAILFLOW_SQL_USERNAME=changeme
RETAILFLOW_SQL_PASSWORD=changeme

# --- Azure (planned, not yet implemented) ---
RETAILFLOW_AZURE_STORAGE_ACCOUNT=changeme

# --- AWS (planned, not yet implemented) ---
RETAILFLOW_AWS_REGION=changeme

# --- Agentic AI (planned, not yet implemented) ---
RETAILFLOW_LLM_PROVIDER=changeme
